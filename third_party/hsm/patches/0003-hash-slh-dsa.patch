 /*static*/ CK_RV SLHDSAUtil::getSLHDSAPrivateKey(SLHDSAPrivateKey* privateKey, Token* token, OSObject* key)
@@ -201,4 +202,52 @@
 	return CKR_OK;
 }
 
+/** \brief setHashOid */
+/*static*/ CK_RV SLHDSAUtil::setHashOid(CK_MECHANISM_TYPE inHash, ByteString* outOid, size_t* outDigestLen)
+{
+	if (outOid == NULL || outDigestLen == NULL)
+	{
+		ERROR_MSG("Invalid parameters, outOid or outDigestLen is NULL");
+		return CKR_ARGUMENTS_BAD;
+	}
+
+	// All of the hashes permitted by FIPS 205 section 10.2 live under the NIST
+	// hashAlgs arc 2.16.840.1.101.3.4.2, so only the final arc differs.
+	unsigned char lastArc;
+	size_t digestLen;
+
+	switch (inHash)
+	{
+	case CKM_SHA256:
+		lastArc = 0x01; digestLen = 32; break;
+	case CKM_SHA384:
+		lastArc = 0x02; digestLen = 48; break;
+	case CKM_SHA512:
+		lastArc = 0x03; digestLen = 64; break;
+	case CKM_SHA224:
+		lastArc = 0x04; digestLen = 28; break;
+	case CKM_SHA3_224:
+		lastArc = 0x07; digestLen = 28; break;
+	case CKM_SHA3_256:
+		lastArc = 0x08; digestLen = 32; break;
+	case CKM_SHA3_384:
+		lastArc = 0x09; digestLen = 48; break;
+	case CKM_SHA3_512:
+		lastArc = 0x0A; digestLen = 64; break;
+	// FIPS 205 also permits SHAKE128/256 as pre-hashes, but PKCS#11 v3.2
+	// defines no digest mechanism for them (only key derivation), so there is
+	// nothing for the caller to name them with here.
+	default:
+		ERROR_MSG("SLH-DSA: Invalid parameters, unsupported pre-hash mechanism (0x%08lX)", (unsigned long)inHash);
+		return CKR_MECHANISM_PARAM_INVALID;
+	}
+
+	const unsigned char oid[] = { 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, lastArc };
+	outOid->resize(sizeof(oid));
+	memcpy(&(*outOid)[0], oid, sizeof(oid));
+	*outDigestLen = digestLen;
+
+	return CKR_OK;
+}
+
 #endif
