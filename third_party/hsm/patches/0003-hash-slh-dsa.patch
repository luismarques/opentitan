From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lowRISC contributors <opentitan@lowrisc.org>
Date: Tue, 18 Aug 2026 00:00:00 +0100
Subject: Implement HashSLH-DSA (CKM_HASH_SLH_DSA)

Patch 0002 mirrors https://github.com/softhsm/SoftHSMv2/pull/862, which
implements the pure SLH-DSA mechanism (CKM_SLH_DSA) only.  OpenTitan also
signs in the pre-hashed domain, which PKCS#11 v3.2 exposes as
CKM_HASH_SLH_DSA: the caller passes a digest plus the mechanism that
produced it, and the token applies the HashSLH-DSA message encoding from
FIPS 205 section 10.2:

    M' = 01 || |ctx| || ctx || OID(hash) || PH_M

OpenSSL will not build that encoding for us -- EVP only offers the pure
encoding -- but it does accept a pre-encoded M' when the signature
parameter "message-encoding" is set to 0 (raw).  So the encoding is built
in OSSLSLHDSA and handed to OpenSSL as a raw message.

This is not upstream; it should be offered to PR 862 (or as a follow-up
to it) rather than carried here indefinitely.

diff --git a/src/lib/crypto/OSSLSLHDSA.cpp b/src/lib/crypto/OSSLSLHDSA.cpp
--- a/src/lib/crypto/OSSLSLHDSA.cpp
+++ b/src/lib/crypto/OSSLSLHDSA.cpp
@@ -27,6 +27,49 @@
 #include <openssl/err.h>
 #include <string.h>
 
+namespace
+{
+	// OpenSSL's message encoding modes, see OSSL_SIGNATURE_PARAM_MESSAGE_ENCODING.
+	// RAW signs the supplied M' verbatim, PURE builds M' = 00 || |ctx| || ctx || M.
+	const int OSSL_SLH_DSA_MESSAGE_ENCODE_RAW = 0;
+
+	/** \brief Build the HashSLH-DSA message encoding of FIPS 205 section 10.2:
+	 *         M' = 01 || |ctx| || ctx || OID || PH_M */
+	bool encodeHashSlhDsaMessage(const SLHDSAMechanismParam* param, const ByteString& digest, ByteString& encoded)
+	{
+		const ByteString& context = param->additionalContext;
+
+		if (context.size() > 255)
+		{
+			ERROR_MSG("Invalid parameters, context length > 255");
+			return false;
+		}
+		if (param->hashDigestLen != 0 && digest.size() != param->hashDigestLen)
+		{
+			ERROR_MSG("SLH-DSA: pre-hashed message is %zu bytes, expected %zu",
+				  digest.size(), param->hashDigestLen);
+			return false;
+		}
+
+		encoded.resize(2 + context.size() + param->hashOid.size() + digest.size());
+		unsigned char* p = &encoded[0];
+		*p++ = 0x01;
+		*p++ = (unsigned char)context.size();
+		if (context.size() > 0)
+		{
+			memcpy(p, context.const_byte_str(), context.size());
+			p += context.size();
+		}
+		memcpy(p, param->hashOid.const_byte_str(), param->hashOid.size());
+		p += param->hashOid.size();
+		if (digest.size() > 0)
+		{
+			memcpy(p, digest.const_byte_str(), digest.size());
+		}
+
+		return true;
+	}
+}
 
